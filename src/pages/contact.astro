---
import Layout from '../layouts/Layout.astro';

const socials = [
    {
        name: "Email",
        handle: "contact@brksfrb.com",
        href: "mailto:contact@brksfrb.com",
        icon: "✉",
        description: "Best for business inquiries",
        color: "#00d4ff",
    },
    {
        name: "LinkedIn",
        handle: "Burak Yılmaz",
        href: "https://www.linkedin.com/in/burak-y%C4%B1lmaz-336788383/",
        icon: "in",
        description: "Professional network",
        color: "#0a66c2",
    },
    {
        name: "Discord",
        handle: "brksfrb",
        href: "https://discord.com/users/579686150663307265",
        icon: "#",
        description: "Best for casual chat",
        color: "#5865f2",
    },
    {
        name: "YouTube",
        handle: "brksfrb",
        href: "https://youtube.com/@brksfrb",
        icon: "▶",
        description: "Devlogs & builds",
        color: "#ff0000",
    },
    /*
    {
        name: "Instagram",
        handle: "YOUR_INSTAGRAM",
        href: "https://instagram.com/YOUR_INSTAGRAM",
        icon: "◈",
        description: "Behind the scenes",
        color: "#e1306c",
    },
    */
    {
        name: "X",
        handle: "brksfrb",
        href: "https://x.com/brksfrb",
        icon: "𝕏",
        description: "Building in public",
        color: "#ffffff",
    },
];
---

<Layout title="Contact — YOUR_NAME" description="Get in touch with YOUR_NAME.">
    <section class="contact-page">
        <div class="container">

            <div class="page-header">
                <span class="mono-dim">// get_in_touch()</span>
                <h1 class="page-title">Contact</h1>
                <p class="page-sub">
                    Whether it's a business inquiry, collaboration, or just saying hi — pick your preferred channel.
                </p>
            </div>

            <div class="socials-grid">
                {socials.map((s, i) => (
                        <a
                                href={s.href}
                                class="social-card reveal"
                                style={`--social-color: ${s.color}; transition-delay: ${i * 60}ms`}
                                target={s.href.startsWith('mailto') ? '_self' : '_blank'}
                                rel="noopener"
                        >
                            <div class="social-top">
                                <span class="social-icon">{s.icon}</span>
                                <span class="social-arrow">→</span>
                            </div>
                            <span class="social-name">{s.name}</span>
                            <span class="social-handle">{s.handle}</span>
                            <span class="social-desc">{s.description}</span>
                            <div class="social-glow"></div>
                        </a>
                ))}
            </div>

        </div>
    </section>
</Layout>

<style>
    :root {
        --bg: #030508;
        --bg-1: #080d14;
        --surface: #111927;
        --surface-2: #162033;
        --border: #1e2d45;
        --border-glow: #1e4a7a;
        --accent: #00d4ff;
        --accent-2: #00ff88;
        --accent-dim: #00d4ff22;
        --text: #e2eaf5;
        --text-dim: #7a9ab8;
        --text-muted: #3a5470;
        --font-mono: 'Space Mono', monospace;
        --font-display: 'Roboto', sans-serif;
        --glow: 0 0 20px #00d4ff33, 0 0 60px #00d4ff11;
    }

    body {
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-display);
    }

    .contact-page { padding: 4rem 0 6rem; }

    .mono-dim {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-muted);
        letter-spacing: 0.05em;
    }

    .page-header { margin-bottom: 3.5rem; }

    .page-title {
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 800;
        color: var(--text);
        letter-spacing: -0.02em;
        margin-top: 0.5rem;
    }

    .page-sub {
        font-size: 1rem;
        color: var(--text-dim);
        margin-top: 0.75rem;
        max-width: 500px;
        line-height: 1.7;
    }

    .socials-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1rem;
    }

    .social-card {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        padding: 1.75rem;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--surface);
        text-decoration: none;
        overflow: hidden;
        transition: all 0.3s;
        border-left: 3px solid var(--social-color, var(--accent));
    }

    .social-card:hover {
        border-color: var(--social-color, var(--accent));
        background: var(--surface-2);
        transform: translateY(-4px);
        box-shadow: 0 8px 30px rgba(0,0,0,0.3);
    }

    .social-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .social-icon {
        font-size: 1.4rem;
        color: var(--social-color, var(--accent));
        font-family: var(--font-mono);
        line-height: 1;
    }

    .social-arrow {
        font-size: 1rem;
        color: var(--text-muted);
        transition: all 0.2s;
        opacity: 0;
        transform: translateX(-4px);
    }

    .social-card:hover .social-arrow {
        opacity: 1;
        transform: translateX(0);
        color: var(--social-color, var(--accent));
    }

    .social-name {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text);
    }

    .social-handle {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--social-color, var(--accent));
        letter-spacing: 0.03em;
    }

    .social-desc {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        color: var(--text-muted);
        margin-top: 0.25rem;
    }

    .social-glow {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 0% 50%, color-mix(in srgb, var(--social-color, var(--accent)) 8%, transparent), transparent 60%);
        opacity: 0;
        transition: opacity 0.4s;
        pointer-events: none;
    }

    .social-card:hover .social-glow { opacity: 1; }

    @media (max-width: 600px) {
        .socials-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @media (max-width: 400px) {
        .socials-grid {
            grid-template-columns: 1fr;
        }
    }
</style>