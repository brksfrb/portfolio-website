            padding: 2rem;
            background: #111;
        }

        .screenshots img {
            width: 300px;
            border-radius: 10px;
            border: 2px solid #222;
        }

        .section {
            max-width: 900px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        h2 {
            color: #ff416c;
            margin-bottom: 1rem;
        }

        p, li {
            color: #ccc;
        }

        ul {
            padding-left: 1.5rem;
        }

        .privacy {
            background: #111;
            padding: 2rem 1rem;
            border-radius: 10px;
        }

        footer {
            text-align: center;
            padding: 1rem;
            color: #888;
        }
    </style>
</head>

